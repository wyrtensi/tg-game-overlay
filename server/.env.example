# Copy this file to .env and fill in both keys. Generate each one with:
#   openssl rand -base64 32
# ACCESS_KEY is shared with the friends who may use the server.
# ADMIN_KEY stays with you and is only needed to upload stickers.
ACCESS_KEY=
ADMIN_KEY=

# Optional: host port (default 8790). 80 and 443 are not needed.
# RELAY_PORT=8790
# Optional: set to 1 only behind a reverse proxy that sets X-Forwarded-For.
# TRUST_PROXY=0
